rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O backend usa a service account (Admin SDK) e ignora estas regras.
    // Clientes do navegador NÃO devem ler/escrever direto — tudo passa pela API.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
